// ==================== FEEDBACK PAGE ====================

class FeedbackPage extends StatefulWidget {
  const FeedbackPage({Key? key}) : super(key: key);

  @override
  State<FeedbackPage> createState() => _FeedbackPageState();
}

class _FeedbackPageState extends State<FeedbackPage> {
  // Controller used to read the feedback entered by the user
  final TextEditingController feedbackController = TextEditingController();

  // Message displayed after submitting
  String message = "";

  // Submit feedback
  void submitFeedback() {
    String feedback = feedbackController.text;

    // Read the entered feedback
    print("Feedback: $feedback");

    setState(() {
      message = "Feedback Submitted";
    });
  }

  @override
  void dispose() {
    feedbackController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Feedback"),
      ),

      // SafeArea prevents content from going underneath
      // system UI areas.
      body: SafeArea(
        // FIX FOR OVERFLOW
        // The page can now scroll on smaller screens.
        child: SingleChildScrollView(
          padding: const EdgeInsets.all(20),
          child: Column(
            children: [
              const SizedBox(height: 20),

              // Feedback heading
              const Text(
                "Enter your feedback",
                textAlign: TextAlign.center,
                style: TextStyle(
                  fontSize: 24,
                  fontWeight: FontWeight.bold,
                ),
              ),

              const SizedBox(height: 20),

              // Feedback TextField
              TextField(
                controller: feedbackController,

                // Reduced from 5 to 4 to fit smaller screens better
                maxLines: 4,

                decoration: const InputDecoration(
                  hintText: "Write your feedback here...",
                  border: OutlineInputBorder(),

                  // Optional label
                  labelText: "Feedback",
                ),
              ),

              const SizedBox(height: 20),

              // Submit Button
              ElevatedButton(
                onPressed: submitFeedback,
                child: const Text(
                  "Submit",
                ),
              ),

              const SizedBox(height: 20),

              // Display message after submission
              Text(
                message,
                textAlign: TextAlign.center,
                style: const TextStyle(
                  fontSize: 20,
                  color: Colors.green,
                  fontWeight: FontWeight.bold,
                ),
              ),

              const SizedBox(height: 20),
            ],
          ),
        ),
      ),
    );
  }
}
